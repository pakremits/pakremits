{
  "name": "pakremits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/with-local-d1.ts next dev",
    "build": "tsx scripts/with-local-d1.ts next build && tsx scripts/write-static-config.ts",
    "preview": "wrangler dev --port 8787 --ip 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:check": "tsx scripts/db-check.ts",
    "db:contract": "tsx scripts/d1-contract.ts",
    "seed": "tsx scripts/seed.ts",
    "providers:sync": "tsx scripts/sync-rate-providers.ts",
    "probe": "tsx scripts/probe.ts",
    "refresh": "tsx scripts/refresh-local.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.8",
    "drizzle-orm": "^0.45.2",
    "libphonenumber-js": "^1.13.12",
    "next": "16.3.8",
    "next-intl": "^4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "^6.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0"
  }
}
