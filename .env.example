# ─── Database (Cloudflare D1) ─────────────────────────────────────────────────
# Scripts use the local D1 by default (npm run db:migrate:local creates it).
# Set D1_TARGET=remote to run them against the real database over the D1 REST
# API; that needs the three values below. The token needs D1 edit permission.
D1_TARGET="local"
CLOUDFLARE_ACCOUNT_ID=""
D1_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Any long random string: `openssl rand -hex 32`
# Set the same value as a GitHub Actions secret named CRON_SECRET, and add a
# repository variable SITE_URL pointing at your deployment.
CRON_SECRET=""

# ─── Admin ────────────────────────────────────────────────────────────────────
# Single password guarding /admin via HTTP Basic auth. Username is ignored.
# Generate one: `openssl rand -base64 24`
ADMIN_PASSWORD=""

# ─── Email (Phase 3) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="PakRemits alerts <alerts@pakremits.com>"

# Cloudflare Turnstile Managed widget. Add the public site key and keep the
# secret server-side. Local development uses Cloudflare's test keys by default.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── WhatsApp / SMS (Phase 3) ─────────────────────────────────────────────────
# Optional. Without these the notifier logs to the console instead of sending,
# so alerts can be developed without a Twilio account.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM=""

# ─── FX ───────────────────────────────────────────────────────────────────────
# Optional. The primary mid-market source (Wise public rates) needs no key.
# Set this only if you add a keyed intraday provider in lib/fx/.
FX_API_KEY=""

# ─── Analytics ────────────────────────────────────────────────────────────────
# Public Google Tag Manager container ID. Optional for local development.
# Set this at build time for production; the container determines which tags run.
NEXT_PUBLIC_GTM_ID=""

# ─── Adapter controls ─────────────────────────────────────────────────────────
# Comma-separated kill switch, e.g. "xe,paysend". Takes a provider out of the
# refresh rotation without a deploy.
BHEJO_DISABLED_ADAPTERS=""
# Set to 1 only in the GitHub Actions runner, which has Chromium available.
# Vercel functions do not, so browser adapters are skipped there.
BHEJO_ALLOW_BROWSER=""

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set true only on the production deployment after moving SITE_URL to the
# production domain. Staging and local builds default to noindex/disallow-all.
ROBOTS_ALLOW_INDEXING="false"
